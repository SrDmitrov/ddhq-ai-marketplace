# Fake .env for testing masker. Every value is made up and grants nothing.
# Built from https://envmanager.com/blog/env-file-example, plus fake provider keys.
#
# `node scripts/check-fixture.ts test/example.env` checks each entry by its section:
#   [mask]        a secret: must be masked
#   [keep]        not a secret: must stay readable
#   [known-miss]  a secret masker misses today (false negative, see README Limits)
#   [known-fp]    not a secret, but masker masks it today (false positive)
# A known-* entry that starts behaving is reported, so the section can be updated.

# [keep]
# App settings
APP_ENV=development
PORT=3000
LOG_LEVEL=debug

# Public app address
APP_URL=http://localhost:3000

# Placeholders from the template
PAYMENT_API_KEY=replace_with_a_local_test_key
SESSION_SECRET=replace_with_a_long_random_value
PAYMENT_API_BASE_URL=https://api.example.test
SESSION_TTL_SECONDS=3600

# Per-environment URLs without credentials
DATABASE_URL=postgres://localhost:5432/store_dev
DATABASE_URL=replace_in_your_deployment_settings

# Required but empty (from .env.example)
DATABASE_URL=
PAYMENT_API_KEY=
SESSION_SECRET=

# Look like secrets by name, are not
AUTH_PROVIDER=basic_auth
TOKEN_REFRESH_ENABLED=true
API_VERSION=2024-06-01
SECRET_NAME=prod-db-password-2
CSRF_TOKEN_HEADER=X-CSRF-Token
ACCESS_TOKEN_URL=https://auth.example.test/oauth/token
CACHE_KEY_PREFIX=store:v2:
API_KEY=${PAYMENT_API_KEY}
GIT_COMMIT_SHA=618cb872420ea1ee3c22ef75db1a2688097dad60
REQUEST_ID=6a92b5af-6069-40b7-a186-1dd40e472524

# [mask]
GITHUB_TOKEN=
